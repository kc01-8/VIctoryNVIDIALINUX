# trustno1's tree (foxhound base) under Proton on NVIDIA (kc/foxhound).
#
# The switches `victory play` starts the title with (apps/victory/src/play.rs,
# SETTINGS), so that `kc-run.sh` and `victory-proton.sh`, which run the title
# with `victory run`, start it the same way. Then what `play` adds for a
# Series X start at 1440p with no frame rate cap and no DLSS (no NVIDIA files
# here), and this fork's Linux choices.
#
# Not set: VICTORY_WAVE_WIDE. Unset, this tree widens only the programs it
# knows need it; `1` widens every one (kc/nvidia's `last` means nothing here).
# Submission and copy machinery
VICTORY_THIN=1
VICTORY_JOIN_PARTS=8
VICTORY_RELAY=2
VICTORY_RELAY_COPY=1
VICTORY_WIDE_BACK=1
VICTORY_CARD_REHASH_RUNS=1
VICTORY_JOIN_COPIES=1
VICTORY_CARD_STEPS=2
VICTORY_CARD_AWAKE=1
VICTORY_CARD_BUFFERS_MIN_KB=64
VICTORY_INDIRECT_WINDOW=1
VICTORY_INDIRECT_BATCH=2
VICTORY_UPLOAD_AHEAD=1
VICTORY_SHOW_AFTER=1
VICTORY_MAP_THREADS=1
# Shader writes into big write-combined copies stay on the card
VICTORY_WC_NO_BACK=1
VICTORY_WC_NO_BACK_MIN_KB=1024
# The title's page-mapping copies kept without Windows views
VICTORY_SOFT_VIEWS=copies
# Textures
VICTORY_TEXTURE_POOL=1
VICTORY_RIPE_BLOCKS=0
VICTORY_TEXTURE_NO_WAIT=1
VICTORY_TEXTURE_CATCHUP=0
VICTORY_TEXTURE_STAGE_MS=16
VICTORY_LEVELS_ON_DEMAND=0
VICTORY_PRELUDE_UPLOADS=1
VICTORY_SHOW_NEW_LATER=1
VICTORY_POOL_SMALL=0
VICTORY_TABLED_REREAD=1
VICTORY_QUEUE_HOST_TEXTURES=0
# Descriptor heaps' records
VICTORY_HEAP_SYNC_FIRST=1
VICTORY_SYNC_IN_PLACE=1
VICTORY_SPANS_QUICK=1
VICTORY_SYNC_FINE=1
VICTORY_HEAP_SYNC_AT_SUBMIT=1
# Light without the title's ray tracing
VICTORY_AMBIENT=0.8
VICTORY_AMBIENT_AIR=1.5
VICTORY_AMBIENT_SPECULAR=1
# Pixel programs keep the console's early depth test
VICTORY_EARLY_DEPTH=1
# Left out: the decal heap's defragmentation and the heat-haze pass
VICTORY_LEAVE_OUT=02384a60fda6f2d0,731a39171b568298
# Pipelines the title makes are written down, for `victory warm`
VICTORY_PIPELINE_BOOK=1

# What `victory play` adds: the title's own 1440p output, no frame rate cap.
VICTORY_NATIVE_1440P=1
VICTORY_FRAME_INTERVAL_US=1000

# trustno1's launcher's tuning for 16 logical CPUs (+22-29 % in heavy scenes on
# an RTX 4070 SUPER): worker pools and the placed order.
VICTORY_PLACED_ORDER=1
VICTORY_THIN_THREADS=12
VICTORY_UNDER_THREADS=8
VICTORY_LAND_THREADS=6

# Linux: the title's own progress watchdog ends slow runs (the hook skips it);
# the card is kept short of its budget, since past it vkd3d-proton puts GPU data
# in the PC's memory (kc/nvidia run 30).
VICTORY_NO_WATCHDOG=1
VICTORY_TEXTURE_ROOM_PERCENT=85

# Windows of title memory read in place instead of copied, those over the
# title's page pool through views of our own: NVIDIA's Linux driver pins
# every page of a copy when it is made, and the copies took the run past an
# 18 GB cap (kc/nvidia runs 24-28; this tree's run 33 was killed at it after
# 2m20s, 5.8 GB of it the driver's).
VICTORY_INPLACE=1
VICTORY_INPLACE_VIEWS=1
# A page-pool cell let go 4 times gets copies, not views: under Wine each
# window remade is tens of wineserver requests that each walk the process's
# ~90,000 views; the windows made 3/4 of them and held the server at 88%
# (runs 70-72). Over 60-260 s: 2.62 fps with views for all, 5.13 with the
# limit at 4 (11.9 GB at most), 10.09 with no views (15.4 GB; runs 72-74).
VICTORY_INPLACE_VIEWS_CHURN=4

# Write faults open guarded blocks under the guards' lock, as by default: with
# VICTORY_FAULT_UNLOCKED=1 (runs 38-53) five runs ended in the title's crash handler 1.5-3
# minutes in, each on a write to title memory still read-only that the guards' handler left
# alone (title code, memcpy, victory's own), a race that Wine's slow VirtualProtect (about
# 0.44 ms a block) opens wide; no run before it ended so.

# Thread groups may use 48 KiB of LDS, Vulkan's limit on NVIDIA, past D3D12's
# 32 KiB: vkd3d-proton passes translated code on unvalidated. The triangle clip's
# meshlet collect (groups of 1,024) uses all 32 KiB itself, and its two host
# waves per console wave need more to meet; without it its dispatches are dropped.
VICTORY_HOST_LDS_KB=48

# The title's window borderless at the screen's own size. Without it the window is fitted to the
# work area (the screen less the taskbar: 2488x1400 for a 2560x1440 picture on a 1440p screen),
# and the swap chain is stretched into it: every frame resampled by 3%, the picture and the
# numbers panel's text soft.
VICTORY_FULLSCREEN=1

# What trustno1's `victory play` now sets as well (63b902fe and foxhound 0.2.0-pre.4): the memory
# stack (textures' slots evicted past 85% of the card's budget, idle allocators and lists trimmed,
# the budget's notes packed), helpers' priority, and a frame's texture passes together within 8 ms
# (39.4 to 47.0 fps on an RTX 4090 there).
VICTORY_SLOT_EVICT=1
VICTORY_ALLOCATOR_TRIM=1
VICTORY_BUDGET_PACK=1
VICTORY_HELPER_PRIORITY=1
VICTORY_PASSES_HOT=1
VICTORY_TEXSPK_PASS_MS=8
